<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ToolButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">2dp</item>
        <item name="android:background">@drawable/bg_tool_btn</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/tool_btn_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <!-- 必须为 true：只要触摸过一次屏幕就进入 touch mode，
             此时 focusableInTouchMode=false 的控件永远拿不到焦点，
             表现就是「能点但十字键选不中」。掌机以手柄为主，不能这样。 -->
        <item name="android:focusableInTouchMode">true</item>
    </style>
</resources>
