<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 的备份与设备迁移规则（dataExtractionRules 渠道），语义同 backup_rules.xml -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
