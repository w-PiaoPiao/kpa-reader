<?xml version="1.0" encoding="utf-8"?>
<!--
  书库横排卡片：只有封面本体（3:4 比例），书名等信息在首页底部信息面板显示。
  横向列表的 item 根必须是 wrap_content（match_parent 会占满整屏宽，一屏只剩一张卡），
  高度铺满 RecyclerView，卡片在其中垂直居中。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/cardBox"
        android:layout_width="104dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginHorizontal="5dp"
        android:background="@drawable/bg_card_sel"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="false">

        <FrameLayout
            android:id="@+id/coverBox"
            android:layout_width="match_parent"
            android:layout_height="139dp"
            android:background="@drawable/bg_cover"
            android:clipToOutline="true"
            android:outlineProvider="background">

            <ImageView
                android:id="@+id/ivCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tvCoverPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/cover_placeholder"
                android:textSize="30sp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/pbProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_gravity="bottom"
                android:max="1000"
                android:progressBackgroundTint="@color/line"
                android:progressTint="@color/progress" />

            <!-- 书名压在封面底部：一排纯封面时中文书名几乎认不出是哪本，
                 焦点卡才在底部面板显示书名太晚 -->
            <TextView
                android:id="@+id/tvCardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_cover_title"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:paddingVertical="3dp"
                android:textColor="@color/text_primary"
                android:textSize="10.5sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvBadgeContinue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="4dp"
            android:background="@drawable/bg_badge_continue"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="▶ 继续"
            android:textColor="@color/on_accent"
            android:textSize="8sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvBadgeDone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:background="@drawable/bg_badge_done"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="读完"
            android:textColor="@color/accent_bright"
            android:textSize="8sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
