<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101317"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.06"
            android:text="口袋阅读"
            android:textColor="#E8E4DA"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnHelp"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_tool_btn"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="按键"
            android:textColor="#DCE3EC"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnImport"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_accent_btn"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="+ 导入"
            android:textColor="#1A1208"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp" />

        <LinearLayout
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="书架还空着"
                android:textColor="#5E6975"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="点右上角「导入」添加 TXT / EPUB / MOBI / AZW3"
                android:textColor="#3E4753"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/importOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#D9101317"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminateTint="#D9A441" />

            <TextView
                android:id="@+id/tvImportState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="正在解析…"
                android:textColor="#C8D0DA"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
